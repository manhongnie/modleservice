# Include inside nginx's http {} context. Supply an actual DNS name/certificate.
# This template was not installed or exercised as an external TLS endpoint.
log_format model_service '$remote_addr [$time_local] $request_method $uri $status $request_time';

server {
    listen 443 ssl;
    server_name inference.example.com;
    ssl_certificate /etc/nginx/tls/inference.fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/inference.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log /var/log/nginx/model-service.access.log model_service;

    client_max_body_size 2m;
    client_body_timeout 15s;
    keepalive_timeout 5s;
    send_timeout 30s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Let ASGI authenticate before reading a request, including chunked bodies.
    proxy_request_buffering off;
    # SSE must reach the caller as chunks are produced.
    proxy_buffering off;
    proxy_cache off;
    proxy_connect_timeout 5s;
    # Queue + load + execution may each consume a separate deadline.
    proxy_read_timeout 600s;
    proxy_send_timeout 30s;
    proxy_next_upstream off;

    location ^~ /admin/ {
        allow 127.0.0.1;
        allow ::1;
        # Add an explicit trusted operations subnet here when required.
        # allow 10.20.30.0/24;
        deny all;
        proxy_pass http://127.0.0.1:8000;
    }
    location /v1/ {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /health {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /ready {
        proxy_pass http://127.0.0.1:8000;
    }
    # Public playground shell; model discovery and inference still require a business key.
    location = / {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /playground.css {
        proxy_pass http://127.0.0.1:8000;
    }
    location = /playground.js {
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        return 404;
    }
}
